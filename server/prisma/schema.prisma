// Prisma Schema for Gym ERP (Consolidated PostgreSQL Schema v1)
// Compatible with Prisma Client & PostgreSQL 14+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================================================
// 1. TENANTS (Gyms)
// ================================================================
model Tenant {
  tenantId           Int       @id @default(autoincrement()) @map("tenant_id")
  tenantCode         String    @unique @db.VarChar(20) @map("tenant_code")
  tenantPrefix       String?   @unique @db.VarChar(6) @map("tenant_prefix")
  gymName            String    @db.VarChar(150) @map("gym_name")
  ownerName          String?   @db.VarChar(100) @map("owner_name")
  email              String    @unique @db.VarChar(150) @map("email")
  phoneNumber        String?   @db.VarChar(20) @map("phone_number")
  addressLine        String?   @db.VarChar(255) @map("address_line")
  city               String?   @db.VarChar(100) @map("city")
  state              String?   @db.VarChar(100) @map("state")
  country            String?   @default("India") @db.VarChar(100) @map("country")
  pincode            String?   @db.VarChar(10) @map("pincode")
  gstNumber          String?   @db.VarChar(20) @map("gst_number")
  logoUrl            String?   @map("logo_url")
  status             String    @default("active") @db.VarChar(20) @map("status")
  planId             Int?      @map("plan_id")
  subscriptionStart  DateTime? @db.Date @map("subscription_start")
  subscriptionEnd    DateTime? @db.Date @map("subscription_end")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  plan               Plan?     @relation(fields: [planId], references: [planId])
  users              User[]
  staff              Staff[]
  plansCatalog       PlansCatalog[]
  members            Member[]
  bankAccounts       BankAccount[]
  upiIds             UpiId[]
  cashTransactions   CashTransaction[]
  receipts           Receipt[]
  approvalHistory    ReceiptApprovalHistory[]
  codeCounters       TenantCodeCounter[]
  expenseTypes       ExpenseType[]
  expenses           Expense[]

  @@index([status])
  @@index([planId])
  @@map("tenants")
}

// ================================================================
// 2. PLANS (SaaS Subscription Plans for Gyms)
// ================================================================
model Plan {
  planId         Int       @id @default(autoincrement()) @map("plan_id")
  planName       String    @db.VarChar(100) @map("plan_name")
  planCode       String    @unique @db.VarChar(30) @map("plan_code")
  durationMonths Int       @db.SmallInt @map("duration_months")
  price          Decimal   @db.Decimal(10, 2) @map("price")
  currency       String    @default("INR") @db.VarChar(10) @map("currency")
  maxMembers     Int?      @map("max_members")
  maxTrainers    Int?      @map("max_trainers")
  features       Json?     @map("features")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenants        Tenant[]

  @@index([isActive])
  @@map("plans")
}

// ================================================================
// 3. USERS (Multi-tenant login accounts)
// ================================================================
model User {
  userId        BigInt    @id @default(autoincrement()) @map("user_id")
  tenantId      Int       @map("tenant_id")
  username      String    @db.VarChar(50) @map("username")
  email         String?   @db.VarChar(150) @map("email")
  phoneNumber   String?   @db.VarChar(20) @map("phone_number")
  passwordHash  String    @map("password_hash")
  role          String    @db.VarChar(20) @map("role")
  fullName      String?   @db.VarChar(100) @map("full_name")
  isActive      Boolean   @default(true) @map("is_active")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  lastLoginAt   DateTime? @db.Timestamptz(6) @map("last_login_at")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  staffProfiles Staff[]
  cashTransactions CashTransaction[]
  submittedReceipts Receipt[] @relation("ReceiptSubmittedBy")
  actionedReceipts  Receipt[] @relation("ReceiptLastActionBy")
  approvalActions   ReceiptApprovalHistory[]
  expensesCreated   Expense[] @relation("ExpenseCreatedBy")

  @@unique([tenantId, username], name: "uq_users_tenant_username")
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([email])
  @@map("users")
}

// ================================================================
// 4. SHARED CODE COUNTERS
// ================================================================
model TenantCodeCounter {
  tenantId   Int      @map("tenant_id")
  entityType String   @db.VarChar(20) @map("entity_type")
  lastNumber BigInt   @default(1000) @map("last_number")

  tenant     Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@id([tenantId, entityType])
  @@map("tenant_code_counters")
}

// ================================================================
// 5. STAFF (Trainers, managers, staff)
// ================================================================
model Staff {
  staffId          BigInt    @id @default(autoincrement()) @map("staff_id")
  tenantId         Int       @map("tenant_id")
  userId           BigInt    @map("user_id")
  staffCode        String?   @unique @db.VarChar(20) @map("staff_code")
  fullName         String    @db.VarChar(100) @map("full_name")
  designation      String    @db.VarChar(100) @map("designation")
  specialization   String?   @db.VarChar(150) @map("specialization")
  experienceYears  Decimal?  @db.Decimal(4, 1) @map("experience_years")
  certifications   String?   @map("certifications")
  email            String?   @db.VarChar(150) @map("email")
  phone            String?   @db.VarChar(20) @map("phone")
  photoUrl         String?   @map("photo_url")
  joiningDate      DateTime  @db.Date @map("joining_date")
  employmentStatus String    @default("active") @db.VarChar(20) @map("employment_status")
  baseSalary       Decimal?  @db.Decimal(10, 2) @map("base_salary")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant           Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  assignedMembers  Member[]

  @@index([tenantId])
  @@index([tenantId, employmentStatus])
  @@index([userId])
  @@map("staff")
}

// ================================================================
// 6. PLANS CATALOG (Gym Member Plans)
// ================================================================
model PlansCatalog {
  planId        BigInt    @id @default(autoincrement()) @map("plan_id")
  tenantId      Int       @map("tenant_id")
  planName      String    @db.VarChar(100) @map("plan_name")
  planCategory  String    @default("Regular") @db.VarChar(30) @map("plan_category")
  durationValue Int       @map("duration_value")
  durationUnit  String    @db.VarChar(20) @map("duration_unit")
  standardFee   Decimal   @db.Decimal(10, 2) @map("standard_fee")
  isActive      Boolean   @default(true) @map("is_active")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  members       Member[]
  receipts      Receipt[]

  @@unique([tenantId, planName], name: "uq_plan_name_per_tenant")
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("plans_catalog")
}

// ================================================================
// 7. MEMBERS
// ================================================================
model Member {
  memberId             BigInt        @id @default(autoincrement()) @map("member_id")
  tenantId             Int           @map("tenant_id")
  memberCode           String?       @unique @db.VarChar(20) @map("member_code")
  fullName             String        @db.VarChar(100) @map("full_name")
  email                String?       @db.VarChar(150) @map("email")
  phone                String        @db.VarChar(20) @map("phone")
  photoUrl             String?       @map("photo_url")
  emergencyContactName String?       @db.VarChar(100) @map("emergency_contact_name")
  emergencyContactPhone String?      @db.VarChar(20) @map("emergency_contact_phone")
  joiningDate          DateTime      @db.Date @map("joining_date")
  assignedTrainerId    BigInt?       @map("assigned_trainer_id")
  currentPlanId        BigInt?       @map("current_plan_id")
  planStartDate        DateTime?     @db.Date @map("plan_start_date")
  feeAmountAtSignup    Decimal?      @db.Decimal(10, 2) @map("fee_amount_at_signup")
  nextDueDate          DateTime?     @db.Date @map("next_due_date")
  isEstimatedDueDate   Boolean       @default(false) @map("is_estimated_due_date")
  status               String        @default("ACTIVE") @db.VarChar(20) @map("status")
  onboardedVia         String        @default("admin") @db.VarChar(20) @map("onboarded_via")
  isDeleted            Boolean       @default(false) @map("is_deleted")
  createdAt            DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant               Tenant        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  assignedTrainer      Staff?        @relation(fields: [assignedTrainerId], references: [staffId])
  currentPlan          PlansCatalog? @relation(fields: [currentPlanId], references: [planId])
  receipts             Receipt[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([assignedTrainerId])
  @@index([tenantId, nextDueDate])
  @@index([currentPlanId])
  @@map("members")
}

// ================================================================
// 8. BANK ACCOUNTS
// ================================================================
model BankAccount {
  bankAccountId        BigInt     @id @default(autoincrement()) @map("bank_account_id")
  tenantId             Int        @map("tenant_id")
  accountName          String     @db.VarChar(100) @map("account_name")
  bankName             String     @db.VarChar(100) @map("bank_name")
  accountHolderName    String?    @db.VarChar(100) @map("account_holder_name")
  accountNumber        String?    @db.VarChar(30) @map("account_number")
  ifscCode             String?    @db.VarChar(15) @map("ifsc_code")
  branchName           String?    @db.VarChar(100) @map("branch_name")
  balanceType          Int        @default(1) @db.SmallInt @map("balance_type")
  openingBalanceAmount Decimal    @default(0) @db.Decimal(12, 2) @map("opening_balance_amount")
  openingBalance       Decimal    @default(0) @db.Decimal(12, 2) @map("opening_balance")
  currentBalance       Decimal    @default(0) @db.Decimal(12, 2) @map("current_balance")
  isPrimary            Boolean    @default(false) @map("is_primary")
  isActive             Boolean    @default(true) @map("is_active")
  isDeleted            Boolean    @default(false) @map("is_deleted")
  createdAt            DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant               Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  upiIds               UpiId[]
  receipts             Receipt[]
  expenses             Expense[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("bank_accounts")
}

// ================================================================
// 9. UPI IDS
// ================================================================
model UpiId {
  upiIdId       BigInt      @id @default(autoincrement()) @map("upi_id_id")
  tenantId      Int         @map("tenant_id")
  bankAccountId BigInt      @map("bank_account_id")
  upiLabel      String      @db.VarChar(50) @map("upi_label")
  upiHandle     String      @db.VarChar(100) @map("upi_handle")
  isPrimary     Boolean     @default(false) @map("is_primary")
  isActive      Boolean     @default(true) @map("is_active")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  createdAt     DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [bankAccountId], onDelete: Cascade)
  receipts      Receipt[]
  expenses      Expense[]

  @@unique([tenantId, upiHandle], name: "uq_upi_handle_per_tenant")
  @@index([tenantId])
  @@index([bankAccountId])
  @@index([tenantId, isActive])
  @@map("upi_ids")
}

// ================================================================
// 10. CASH TRANSACTIONS
// ================================================================
model CashTransaction {
  transactionId   BigInt    @id @default(autoincrement()) @map("transaction_id")
  tenantId        Int       @map("tenant_id")
  transactionType Int       @db.SmallInt @map("transaction_type")
  amount          Decimal   @db.Decimal(12, 2) @map("amount")
  isOpening       Int       @default(1) @db.SmallInt @map("is_opening")
  transactionDate DateTime  @default(now()) @db.Date @map("transaction_date")
  referenceType   String?   @db.VarChar(30) @map("reference_type")
  referenceId     BigInt?   @map("reference_id")
  description     String?   @map("description")
  createdBy       BigInt?   @map("created_by")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  creator         User?     @relation(fields: [createdBy], references: [userId])

  @@index([tenantId])
  @@index([tenantId, transactionDate])
  @@index([tenantId, isOpening])
  @@index([referenceType, referenceId])
  @@map("cash_transactions")
}

// ================================================================
// 11. RECEIPTS & APPROVAL HISTORY
// ================================================================
model Receipt {
  receiptId        BigInt                  @id @default(autoincrement()) @map("receipt_id")
  tenantId         Int                     @map("tenant_id")
  receiptCode      String?                 @unique @db.VarChar(20) @map("receipt_code")
  memberId         BigInt                  @map("member_id")
  planId           BigInt?                 @map("plan_id")
  paymentFor       String                  @default("FEES") @db.VarChar(20) @map("payment_for")
  amount           Decimal                 @db.Decimal(10, 2) @map("amount")
  taxAmount        Decimal                 @default(0) @db.Decimal(10, 2) @map("tax_amount")
  totalAmount      Decimal                 @db.Decimal(10, 2) @map("total_amount")
  paymentDate      DateTime                @default(now()) @db.Date @map("payment_date")
  paymentMode      String                  @db.VarChar(20) @map("payment_mode")
  bankAccountId    BigInt?                 @map("bank_account_id")
  upiIdId          BigInt?                 @map("upi_id_id")
  referenceNo      String?                 @db.VarChar(100) @map("reference_no")
  approvalStatus   Int                     @default(1) @db.SmallInt @map("approval_status")
  submittedBy      BigInt                  @map("submitted_by")
  submittedRole    String                  @db.VarChar(20) @map("submitted_role")
  lastActionBy     BigInt?                 @map("last_action_by")
  lastActionNote   String?                 @map("last_action_note")
  isDeleted        Boolean                 @default(false) @map("is_deleted")
  createdAt        DateTime                @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime                @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  member           Member                  @relation(fields: [memberId], references: [memberId])
  plan             PlansCatalog?           @relation(fields: [planId], references: [planId])
  bankAccount      BankAccount?            @relation(fields: [bankAccountId], references: [bankAccountId])
  upiId            UpiId?                  @relation(fields: [upiIdId], references: [upiIdId])
  submittedByUser  User                    @relation("ReceiptSubmittedBy", fields: [submittedBy], references: [userId])
  lastActionByUser User?                   @relation("ReceiptLastActionBy", fields: [lastActionBy], references: [userId])
  approvalHistory  ReceiptApprovalHistory[]

  @@index([tenantId])
  @@index([memberId])
  @@index([tenantId, approvalStatus])
  @@index([tenantId, paymentDate])
  @@index([tenantId, paymentFor])
  @@index([bankAccountId])
  @@index([upiIdId])
  @@map("receipts")
}

model ReceiptApprovalHistory {
  historyId      BigInt    @id @default(autoincrement()) @map("history_id")
  tenantId       Int       @map("tenant_id")
  receiptId      BigInt    @map("receipt_id")
  previousStatus Int?      @db.SmallInt @map("previous_status")
  newStatus      Int       @db.SmallInt @map("new_status")
  actionBy       BigInt    @map("action_by")
  actionNote     String?   @map("action_note")
  actionAt       DateTime  @default(now()) @db.Timestamptz(6) @map("action_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  receipt        Receipt   @relation(fields: [receiptId], references: [receiptId], onDelete: Cascade)
  actionByUser   User      @relation(fields: [actionBy], references: [userId])

  @@index([tenantId])
  @@index([receiptId, actionAt])
  @@map("receipt_approval_history")
}

// ================================================================
// 12. EXPENSE TYPES & EXPENSES
// ================================================================
model ExpenseType {
  expenseTypeId BigInt    @id @default(autoincrement()) @map("expense_type_id")
  tenantId      Int       @map("tenant_id")
  name          String    @db.VarChar(100) @map("name")
  description   String?   @map("description")
  isSystem      Boolean   @default(false) @map("is_system")
  isActive      Boolean   @default(true) @map("is_active")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  expenses      Expense[]

  @@unique([tenantId, name], name: "uq_expense_types_tenant_name")
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("expense_types")
}

model Expense {
  expenseId        BigInt       @id @default(autoincrement()) @map("expense_id")
  tenantId         Int          @map("tenant_id")
  expenseCode      String?      @db.VarChar(30) @map("expense_code")
  expenseTypeId    BigInt       @map("expense_type_id")
  title            String       @db.VarChar(150) @map("title")
  amount           Decimal      @db.Decimal(10, 2) @map("amount")
  expenseDate      DateTime     @default(now()) @db.Date @map("expense_date")
  paymentMode      String       @db.VarChar(20) @map("payment_mode")
  bankAccountId    BigInt?      @map("bank_account_id")
  upiIdId          BigInt?      @map("upi_id_id")
  referenceNo      String?      @db.VarChar(100) @map("reference_no")
  notes            String?      @map("notes")
  salarySlipId     BigInt?      @map("salary_slip_id")
  salaryPaymentId  BigInt?      @map("salary_payment_id")
  createdBy        BigInt?      @map("created_by")
  isDeleted        Boolean      @default(false) @map("is_deleted")
  createdAt        DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  expenseType      ExpenseType  @relation(fields: [expenseTypeId], references: [expenseTypeId])
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [bankAccountId])
  upiId            UpiId?       @relation(fields: [upiIdId], references: [upiIdId])
  createdByUser    User?        @relation("ExpenseCreatedBy", fields: [createdBy], references: [userId])

  @@index([tenantId, expenseDate])
  @@index([tenantId, expenseTypeId])
  @@index([salarySlipId])
  @@index([salaryPaymentId])
  @@index([bankAccountId])
  @@index([tenantId, isDeleted])
  @@map("expenses")
}
